# Copy to .env. Nothing here reaches a browser: this file is read by the
# Backend only, and the frontend never sees these values.

# The retrieval service: the Function App that ingests documents and answers
# retrieval over them. No trailing slash.
UPSTREAM=https://your-app.azurewebsites.net

# Behind a gateway, UPSTREAM is the gateway's address alone, and these two are
# the retrieval service's own VECTRIXDB_PREFIX and VECTRIXDB_GATEWAY_PATHS,
# so each call goes where its route is published. Empty: called directly.
#   UPSTREAM_PREFIX=acme
#   UPSTREAM_GATEWAY_PATHS=api/v1=/files/search, auth=/files/auth
UPSTREAM_PREFIX=
UPSTREAM_GATEWAY_PATHS=

# Its key, when it has one. The library's key layer reads it from the api-key
# header, which is what UPSTREAM_KEY_HEADER changes if yours differs.
UPSTREAM_KEY=
UPSTREAM_KEY_HEADER=api-key

# Where the built pages are. Left out, ../Frontend/dist beside this folder.
SITE_DIR=

# Seconds to wait for the service. Azure ends a request at 230, so waiting
# longer waits for an answer that cannot come.
TIMEOUT=230
