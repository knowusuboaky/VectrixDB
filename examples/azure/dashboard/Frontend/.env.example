# Copy to .env. Nothing here is a secret: every VITE_ value is compiled into
# the browser bundle, so the upstream's key belongs in the Backend's .env only.

# Where the dev server sends /api, /auth, /health and /openapi.json: the
# Backend in this folder pair, which forwards to the function app.
VITE_DEV_UPSTREAM=http://127.0.0.1:8000
