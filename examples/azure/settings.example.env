# Copy this file to settings.env and change the first line. The rest have
# working defaults. settings.env is never committed.

# A short word, 4 to 16 letters and digits, starting with a letter, that
# nobody else in Azure has used. A storage account and a search service are
# named from it, and both names are global. Add digits to make it yours.
VX_PREFIX=vxlive0000

# Where the resources go. Canada Central bills in CAD and is close to you.
# Every service here has to exist in the region you pick.
VX_LOCATION=canadacentral

# No region has room for everything at every moment. When VX_LOCATION will
# not take a resource it is asked for in each of these, in the order written,
# and the script says which region took it. Every step follows it.
VX_ELSEWHERE=eastus,westus

# free  costs nothing, 50 MB, no semantic ranker, one per subscription
# basic about 3 to 4 CAD a day, and the semantic ranker the library can use
VX_SEARCH_TIER=basic

# The collections. One index each in the service, and one folder each inside
# the ingestion container: a blob at ingestion/raw/financial/x.pdf goes to the
# financial collection. Three is enough to see the dashboard with more than
# one of anything in it.
VX_COLLECTIONS=financial,media,misc

# Who may retrieve from each collection is in its record,
# .local/cosmosdb/data_db/collection_records/<collection>.json: security
# groups, listed people, or everyone who signs in. A collection with no
# policy answers nobody. The three seeds show the three ways.

# yes  makes an Azure AI Vision resource, which writes a description under
#      every picture: what it is, and the words printed inside it. That is
#      what makes a chart findable by what it shows rather than its caption.
#      It needs no GPT quota, which a new subscription does not have, and its
#      free tier covers 5,000 pictures a month.
# no   everything else still works; a figure keeps its caption and its image.
VX_VISION=yes

# yes  03's chat model describes every picture in detail, in front of Vision:
#      who and what is in it, every word printed in it, and a chart's every
#      value as rows. It needs GPT quota, and is paid per picture.
# no   Vision alone: a caption, and the words in the picture.
VX_DETAILED_PICTURES=no

# Captioning is offered in some regions and not others, and Canada Central is
# not one of them, so the Vision resource goes where it works. The OCR half
# works everywhere; without a captioning region a figure is described by the
# words in it alone.
VX_VISION_LOCATION=eastus

# yes  makes an Azure AI Language resource, which the extraction app masks
#      with: the names, addresses and national ids in a document, found
#      before its Markdown is kept, in English and French alike, so the index
#      never holds them. Its free tier covers 5,000 text records a month.
# no   the patterns alone: emails, phone numbers, cards and ids by their shape.
VX_LANGUAGE=yes

# yes  03 makes an Azure AI Translator on its free tier, 2 million characters
#      a month, and the extraction app's /translate routes answer with it.
# no   /translate/text and /translate/detect answer 503 and name the setting
#      they need. /translate/languages answers either way.
VX_TRANSLATOR=yes

# The languages the documents are in, for masking: what Language is told, and
# what the app says it covers. Comma separated.
VX_MASKING_LANGUAGES=en,fr

# yes  makes an Azure OpenAI resource: the chat model that drafts the golden
#      questions and, when VX_DETAILED_PICTURES says yes, describes pictures,
#      and the second vector's embedding model.
# no   none of them: one vector, and the golden questions written by hand.
VX_OPENAI=yes

# yes  every chunk is embedded twice, with the built-in model and with Azure
#      OpenAI's, and the index fuses the two with RRF: the evaluation
#      compares fourteen ways of searching a collection.
# no   the built-in model alone: six ways, and no Azure OpenAI calls to embed.
VX_SECOND_VECTOR=yes

# The chat model 03 deploys on that resource, which the main app drafts the
# golden questions with, step four, and answers questions with, step ten.
# It reads pictures too. The API version is 2024-10-21 when left empty.
# gpt-4o-mini was the first choice and Azure takes no new deployment of it.
AZURE_OPENAI_WRITER_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=

# How the main app cuts the documents, step six. auto follows step five, the
# comparison 08_evaluate.py --chunking asks for: its best cut over checked
# questions, until a later run beats it by more than luck. Until the first
# pick, every file's Markdown is kept and nothing is indexed. A build pins a
# cut instead, <technique>-<size>-<h|n|c|l>: markdown-1000-h is Structure-aware
# at 1,000 characters with its headings in front of each chunk.
INGEST_CHUNKING=auto

# How the main app searches when it answers a question, step ten. auto follows
# each collection's best_for_balance from step nine, 08_evaluate.py, and
# finds_the_most or best_for_time follow that pick instead. A way of searching
# pins one in every collection: hybrid_semantic.both, say.
RETRIEVAL_SETUP=auto

# yes  makes a Cosmos DB account for the parent sections: the enclosing
#      passages that small chunks point back to, which a search returns
#      rather than searches. They have to be somewhere every instance can
#      read, because the one that ingested a document is not the one
#      answering the question, and a file on a function app's disk is
#      neither shared nor kept. A second container holds a copy of every
#      chunk for the collection pages, for the same reason: the dashboard
#      is not the instance that ingested. Azure gives one free Cosmos
#      account a subscription, 1000 RU/s and 25 GB; the two containers are
#      800 of it.
# no   the parents fall back to a file on the instance, which works for one
#      process and silently returns nothing for two, and the collection
#      pages count only what the instance serving them wrote.
VX_COSMOS=yes

# The free tier is one account a subscription. If you already spent it, this
# says no and the account is made serverless instead, which bills per
# request and is pennies at this size.
VX_COSMOS_FREE=yes

# Cosmos is not offered everywhere at every moment. Canada Central refused
# this outright: "we are currently experiencing high demand in Canada Central
# region, and cannot fulfill your request at this time". Left empty, the
# account goes in VX_LOCATION and falls back to VX_COSMOS_ELSEWHERE when the
# region has no room: one region, or several tried in the order written.
# Parents are read once per result, so a few dozen milliseconds of distance
# costs nothing worth measuring.
VX_COSMOS_LOCATION=
# VX_COSMOS_ELSEWHERE=           its own order; left out, it follows VX_ELSEWHERE

# A region can offer a model and give your subscription no quota for it.
# Step 03 asks each region, VX_LOCATION first and then these in order, and
# puts the Azure OpenAI account in the first that has every model wanted.
# VX_OPENAI_ELSEWHERE=           its own order; left out, it follows VX_ELSEWHERE

# yes       the query app asks people to sign in, which is what a collection's
#           policy judges and what fills the Access page and the Overview charts.
#           The app sends no mail, so the first person is added from this machine,
#           and their one-time link is printed in the terminal that added them:
#           python 06_create_main_function_app.py --add-person you@example.com
# sso       the enterprise way, for the team that owns the platform: the
#           company's single sign-on, or a work email and the code from an
#           authenticator app, from one People list. No passkeys. See
#           VX_SIGNIN_USERS and VX_OIDC_ below. The people who use the
#           collections are named by each collection's policy, not here.
# sso-only  the company's single sign-on and nothing of anybody's own.
#           While VX_OIDC_ISSUER and VX_OIDC_CLIENT_ID are both empty, the
#           button checks, says single sign-on is not configured, and opens
#           the email way: the People list signs in with a work email and a
#           code. No passkeys.
# no        an API key only, and those pages stay empty.
VX_SIGNIN=yes

# yes  with sign-in on, somebody who has not signed in is a guest: the
#      overview, every collection's name and size, and the evaluations, never
#      a search.
# no   nothing but the sign-in box until they sign in.
VX_GUESTS=yes

# With VX_SIGNIN=yes, no single sign-on is set up, and:
# yes  after the work email, the sign-in box asks for a password and the code
#      from an authenticator app, the two together, never a password alone.
#      Each person sets their password from the link --add-person prints.
# no   a passkey, or the code, with the work email.
VX_SIGNIN_PASSWORDS=no

# VX_SIGNIN=sso or sso-only. A security group alone is not enough: the People
# list says who may sign in and each one's role, VX_SIGNIN_USERS adds whoever
# is missing from it, and 06 stops without a list. VX_OIDC_ALLOWED_EMAILS lets
# in more addresses, or a domain, beside it, with their groups' role. The
# client secret is best a key vault reference, which Azure reads for the app.
# VX_SIGNIN_USERS=ama@northwind.example:admin,kofi@northwind.example:operator
# VX_OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# VX_OIDC_CLIENT_ID=<the app registration's client id>
# VX_OIDC_CLIENT_SECRET=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/vx-oidc-secret/)
# VX_OIDC_ROLE_MAP={"<the platform team's group object id>": "admin"}
# VX_OIDC_ALLOWED_EMAILS=@contractors.northwind.example
# An app calling for the person using it, such as another team's search page:
# its access token's audience, and the role such a token has here. A token
# needs no place on the People list: each collection's policy decides.
# With VX_SIGNIN=sso, a code works only for somebody the
# company's sign-in let in within VX_SSO_RECHECK_DAYS days.
# VX_OIDC_API_AUDIENCE=api://vectrixdb
# VX_OIDC_TOKEN_ROLE=searcher
# VX_SSO_RECHECK_DAYS=30

# Emergency sign-in, with any VX_SIGNIN but no, for while the usual sign-in is
# down. Nothing links to it:
# one named admin at /dashboard/#/break-glass, with a password, each use
# written to the access log, until the time it is given. The password stays
# in the key vault VX_KEY_VAULT names, as vx-break-glass, and only its hash is
# set here. Make both with:
#   python 06_create_main_function_app.py --new-break-glass
# A password works for one emergency, so run that again before the next.
# Turn it on only in the emergency, and off again once sign-in is back: change
# VX_BREAK_GLASS and run 06 --settings-only.
VX_BREAK_GLASS=no
# VX_BREAK_GLASS_UNTIL=2026-09-28T02:00Z
# VX_BREAK_GLASS_ADMIN=emergency.admin
# VX_BREAK_GLASS_PASSWORD_HASH=
# VX_KEY_VAULT=northwind-vault

# The company's own look on both dashboards, set once on the query app. Left
# out, the dashboards are VectrixDB's. A logo is a square SVG, PNG or JPEG on
# this machine, and the palette a JSON file or one line of JSON: a function
# app keeps no files, so 06 sends each inside its setting, and has the
# library read it first. The wordmark sets the name larger, in the accent.
# The line under the sidebar reads © 2026 and whoever VX_BRAND_COPYRIGHT names.
# VX_BRAND_NAME=Northwind
# VX_BRAND_LOGO=C:\brand\northwind-mark.svg
# VX_BRAND_LOGO_DARK=
# VX_BRAND_ACCENT=#0b5cad
# VX_BRAND_WORDMARK=yes
# VX_BRAND_COPYRIGHT=Northwind
# VX_BRAND_PALETTE=C:\brand\palette.json

# How many days the audit container keeps each line before it may be
# deleted. Every sign-in, read and refusal is a line appended there that
# nobody can change. The policy is left
# unlocked, so 99_delete_everything.py can still remove it all.
VX_AUDIT_DAYS=7

# A gateway in front of the query app, such as API Management. Blank calls the
# app at its own address. Its team hands over the address and a path for each
# endpoint or family of them, and your prefix sits between the two:
#   https://gateway.example.com / files/search / acme / api/v1/collections/handbook/text-search
# The gateway's address, which people type and single sign-on returns to.
#   VX_GATEWAY_URL=https://gateway.example.com
# The path every route lives under, your choice. Empty keeps them at the root.
#   VX_QUERY_PREFIX=acme
# Each route's own gateway path, route=path with commas between. A route is
# named with no prefix, alone or as a family: api/v1 is every API route.
#   VX_QUERY_GATEWAY_PATHS=api/v1=/files/search, auth=/files/auth, dashboard=/files/dash
# The gateway's own addresses, whose X-Forwarded-For says who is calling, so
# one person's wrong tries lock out nobody else.
#   VX_TRUSTED_PROXIES=10.0.0.0/8
# The headers a key and a person's token arrive in, when the gateway keeps
# api-key and Authorization for itself.
#   VX_KEY_HEADER=x-search-key
#   VX_TOKEN_HEADER=x-user-token
VX_GATEWAY_URL=
VX_QUERY_PREFIX=
VX_QUERY_GATEWAY_PATHS=
VX_TRUSTED_PROXIES=
VX_KEY_HEADER=
VX_TOKEN_HEADER=

# The extraction service, 05_create_extraction_function_app.py: a Function
# App of its own, a utility API that reads files, addresses and videos and
# hands back text. It stands alone, and nothing here matters unless you run it.
#
# The path every route lives under, your choice. Empty keeps them at the root.
#   VX_EXTRACT_PREFIX=/acme
# Behind a gateway that gives each endpoint a path of its own: the paths its
# team hands over, route=path with commas between.
#   VX_EXTRACT_GATEWAY_PATHS=extract/pdf=/files/pdf, jobs=/media/jobs
# The only hosts the routes that fetch an address may fetch from; *.example.org
# for a domain's subdomains. Empty means none, and every address is refused.
# www.td.com is where the walkthrough's own reports come from, in
# .local/sources.json, so the address routes have something to read. It is
# a list of who is trusted: add a host only when you mean it.
#   VX_EXTRACT_URL_HOSTS=www.example.com, *.example.org
VX_EXTRACT_PREFIX=
VX_EXTRACT_GATEWAY_PATHS=
VX_EXTRACT_URL_HOSTS=www.td.com
# How the extraction app reads a PDF. text, the default, reads the PDF's own
# text and sends only scanned pages to Document Intelligence. vision does the
# same, and sends the pages the rules are unsure of, a chart, big figures set
# apart from their labels, a page whose parts are drawn out of order, to 03's
# chat model with a picture of the page; every number it writes is held to
# the page's own words. It needs VX_DETAILED_PICTURES=yes, which gives the app
# the model, and is paid for the pages it reads, a tenth of a report or so.
# VX_VISION_PAGES=all sends it every page instead. layout sends every page to
# Document Intelligence's layout model: tables come back as rows, the headings
# it sees, the number printed on each page, no running headers, and every
# chart cut out for Vision to describe. layout is paid for every page.
#   VX_EXTRACT_PDF=vision
#   VX_EXTRACT_PDF=layout
VX_EXTRACT_PDF=
VX_VISION_PAGES=

# The main app reads a long file through the extraction app in pieces, each
# one call inside the 230 seconds Azure gives an HTTP request: sound in pieces
# of this many minutes, cut at a pause, and a PDF this many pages at a time.
EXTRACTION_BATCH_MINUTES=10
EXTRACTION_BATCH_PAGES=20

# The chat model 08_evaluate.py --write drafts the golden questions with. Any
# chat completions address: a model served on this machine, or one on Azure
# AI Foundry with its key. Left empty, --write says so and writes nothing.
#   VECTRIXDB_WRITER_URL=http://localhost:11434/v1/chat/completions
#   VECTRIXDB_WRITER_MODEL=phi4-mini
#   VECTRIXDB_WRITER_KEY=
VECTRIXDB_WRITER_URL=
VECTRIXDB_WRITER_MODEL=

# How the query app scales. Flex Consumption gives a Python app one web request
# an instance unless told, so a dashboard page, which asks for ten files at
# once, starts ten instances, each cold: about fifteen seconds for a request
# that takes milliseconds.
# VX_QUERY_AT_ONCE       web requests one instance takes at once. 16 unless set.
# VX_QUERY_ALWAYS_READY  instances kept ready, paid for by the hour whether or
#                        not anybody calls. 0 keeps none, and the first call
#                        after a quiet spell waits for a start.
# 06 --settings-only sends both.
VX_QUERY_AT_ONCE=16
VX_QUERY_ALWAYS_READY=0

# Names are worked out from VX_PREFIX. Set one here only to override it.
# VX_RESOURCE_GROUP=
# VX_STORAGE=
# VX_SEARCH=
# VX_FUNCTION_APP=
# VX_QUERY_APP=
# VX_EXTRACT_APP=
# VX_DOCINTEL=
# VX_SPEECH=
# VX_OPENAI_NAME=
# AZURE_OPENAI_VISION_DEPLOYMENT=gpt-5.4-mini
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
