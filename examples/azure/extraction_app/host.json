{
  "version": "2.0",
  "functionTimeout": "01:00:00",
  "logging": {
    "logLevel": {
      "default": "Information",
      "vectrixdb": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": false
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:10:00",
      "messageEncoding": "none"
    },
    "http": {
      "routePrefix": ""
    }
  }
}
