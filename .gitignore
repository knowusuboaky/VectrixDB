# The walkthroughs and sample apps are kept on the machine that runs them and
# out of the repository. Only the top-level folder: each client's examples
# under sdk/ are part of it.
/examples/

# A crash dump the shell leaves behind
*.stackdump

# The key the Compose setup reads, made on the machine that runs it
docker/*.key

# A collection written by 2.1.7, which the suite opens: kept, whatever its files are called
!tests/fixtures/legacy_2_1_7/**

# The SDKs' own build output and dependencies
node_modules/
sdk/rust/target/

# Hypothesis keeps its example database here.
.hypothesis/
